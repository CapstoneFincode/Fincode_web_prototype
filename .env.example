# Copy to .env. Never commit real credentials.
# PostgreSQL startup requires a nonempty password. Data lives in fincode_pg volume.
POSTGRES_PASSWORD=
# Dataset CRUD works without this key; model calls require it.
BAZE_API_KEY=
# Local Python (outside Compose) only: set your own DSN and run python -m backend.migrate.
# DATABASE_URL=postgresql://fincode:password@localhost:5432/fincode
# Remote Worker -> HTTPS FastAPI backend: same secret on both servers; never in browser JS.
BACKEND_SHARED_TOKEN=
# Worker-only config, not needed for local Compose:
# BACKEND_API_URL=https://your-backend.example.com
# Hosted Python backend only (Railway is also detected automatically):
# FINCODE_ENV=production
# BACKEND_SHARED_TOKEN must then be 32-256 printable ASCII characters without spaces.
# PORT is assigned by the hosting provider; defaults to 8000 locally.

# Attachment originals. Upload is unavailable until storage and DB are configured.
# Hosted deployments require a PRIVATE S3-compatible bucket; local container disk
# must not be used as durable production storage. Never expose these keys to JS.
FINCODE_ATTACHMENT_STORAGE=
# Set "s3" above and configure a private bucket, e.g. Railway Storage Buckets.
FINCODE_ATTACHMENT_S3_ENDPOINT=
FINCODE_ATTACHMENT_S3_BUCKET=
FINCODE_ATTACHMENT_S3_ACCESS_KEY_ID=
FINCODE_ATTACHMENT_S3_SECRET_ACCESS_KEY=
FINCODE_ATTACHMENT_S3_REGION=auto
# Development only: set "local" above and an absolute directory outside the repo.
# FINCODE_ATTACHMENT_DIRECTORY=/absolute/path/to/fincode-attachment-originals
# Local Compose supplies its own persistent fincode_attachments volume and
# defaults an empty FINCODE_ATTACHMENT_STORAGE setting to local.
