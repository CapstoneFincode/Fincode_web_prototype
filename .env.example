# Copy to .env. Never commit real credentials.
# PostgreSQL startup requires a nonempty password. Data lives in fincode_pg volume.
POSTGRES_PASSWORD=
# Dataset CRUD works without this key; model calls require it.
BAZE_API_KEY=
# Local Python (outside Compose) only: set your own DSN and run python -m backend.migrate.
# DATABASE_URL=postgresql://fincode:password@localhost:5432/fincode
# Remote Worker -> HTTPS FastAPI backend: same secret on both servers; never in browser JS.
BACKEND_SHARED_TOKEN=
# Worker-only config, not needed for local Compose:
# BACKEND_API_URL=https://your-backend.example.com
